{
  "name": "Blaise workspace",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "forwardPorts": [
    7777
  ],
  "portsAttributes": {
    "7777": {
      "label": "Blaise agent",
      "visibility": "private",
      "onAutoForward": "silent"
    }
  },
  "postStartCommand": "bash -lc 'nohup node .devcontainer/blaise/agent.mjs >> /tmp/blaise-agent.log 2>&1 &'"
}
